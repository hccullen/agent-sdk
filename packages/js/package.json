{
  "name": "@newsioaps/agent-sdk",
  "version": "1.0.0",
  "description": "Type-safe SDK for the Corti Agent API v2, built on openapi-ts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hccullen/agent-sdk.git"
  },
  "homepage": "https://github.com/hccullen/agent-sdk",
  "bugs": {
    "url": "https://github.com/hccullen/agent-sdk/issues"
  },
  "scripts": {
    "generate": "openapi-typescript ./openapi/agent-api-v2.yml -o ./src/gen/api-v2.d.ts --default-non-nullable false",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "corti",
    "agents",
    "ai",
    "sdk",
    "a2a",
    "mcp",
    "workflow",
    "state-machine",
    "multi-agent",
    "agentic",
    "llm"
  ],
  "author": "Corti <developer@corti.ai>",
  "license": "MIT",
  "peerDependencies": {
    "@corti/sdk": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@corti/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@corti/sdk": "3.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@bufbuild/cel": "^0.6.0",
    "openapi-fetch": "^0.17.0"
  }
}
