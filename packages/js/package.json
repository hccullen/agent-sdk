{
  "name": "@newsioaps/agent-sdk",
  "version": "4.1.0",
  "description": "Type-safe SDK for the Corti Agent API v2, built on @corti/sdk",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./handle": {
      "types": "./dist/handle.d.ts",
      "import": "./dist/handle.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js"
    },
    "./graph": {
      "types": "./dist/stateGraph.d.ts",
      "import": "./dist/stateGraph.js"
    },
    "./declarative-graph": {
      "types": "./dist/declarativeGraph.d.ts",
      "import": "./dist/declarativeGraph.js"
    },
    "./streaming": {
      "types": "./dist/streaming.d.ts",
      "import": "./dist/streaming.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hccullen/agent-sdk.git"
  },
  "homepage": "https://github.com/hccullen/agent-sdk",
  "bugs": {
    "url": "https://github.com/hccullen/agent-sdk/issues"
  },
  "scripts": {
    "prebuild": "node -e \"const p=require('./package.json');require('fs').writeFileSync('src/version.gen.ts','// AUTO-GENERATED by prebuild - do not edit\\nexport const PKG_NAME = ' + JSON.stringify(p.name) + ';\\nexport const PKG_VERSION = ' + JSON.stringify(p.version) + ';\\n')\"",
    "build": "npm run prebuild && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "pretest": "npm run prebuild",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "corti",
    "agents",
    "ai",
    "sdk",
    "a2a",
    "mcp",
    "workflow",
    "state-machine",
    "multi-agent",
    "agentic",
    "llm"
  ],
  "author": "Corti <developer@corti.ai>",
  "peerDependencies": {
    "@corti/sdk": ">=5.0.0"
  },
  "devDependencies": {
    "@corti/sdk": "5.0.0",
    "@vitest/coverage-v8": "5.0.1",
    "typescript": "~5.7.2",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@bufbuild/cel": "^0.6.0",
    "@bufbuild/protobuf": "^2.15.0",
    "ajv": "^8.20.0",
    "js-yaml": "5.4.2"
  }
}
